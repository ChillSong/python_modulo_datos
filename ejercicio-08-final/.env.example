# Rutas de datos (montadas como volumenes en Docker)
PARQUET_PATH=/data/benchmark_1m/transactions.snappy.parquet
DB_PATH=/db/transactions.db

# Directorio donde esta el Parquet en tu maquina (usado por docker-compose)
DATA_DIR=../data

# TTL del cache en segundos (0 = deshabilitar)
CACHE_TTL_SUMMARY=30
CACHE_TTL_TOP_MERCHANTS=30
CACHE_TTL_ANOMALIES=30
